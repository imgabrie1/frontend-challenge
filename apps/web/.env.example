# Variável obrigatória para ativar os mocks do MSW no build/produção
VITE_MSW_ENABLED=true

# (Opcional) URL base da API REST - padrão: '/api' (mesma origem intercepted por MSW)
# VITE_API_URL=/api

# (Opcional) URL do WebSocket Socket.IO - padrão: window.location.origin
# VITE_SOCKET_URL=http://localhost:5173
