{
  "name": "frontend-challenge-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "rm -rf dist && npm --prefix apps/web run dev",
    "dev:mock": "npm --prefix apps/web run dev:mock",
    "build": "npm --prefix apps/web run build",
    "build:demo": "npm --prefix apps/web run build:demo",
    "preview": "npm --prefix apps/web run preview",
    "typecheck": "npm --prefix apps/web run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "lighthouse": "npm --prefix apps/web run lighthouse"
  }
}
